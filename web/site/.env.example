# ==============================================================================
# UIGrade AI - Environment Configuration Example
# ==============================================================================

# Next.js Server & Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration (Database, Authentication, Storage & Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-admin-key

# ------------------------------------------------------------------------------
# Legacy / Fallback Settings (Optional)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/android_grader_db
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long

# ------------------------------------------------------------------------------
# AI & Gemini API Services (UI Rubric & Screenshot Evaluation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=your-optional-openai-api-key

# ------------------------------------------------------------------------------
# Notification & Automation Tokens
# ------------------------------------------------------------------------------
NOTIFICATION_CRON_TOKEN=your-cron-secret-token

# ------------------------------------------------------------------------------
# Android Emulator & Runner Settings (Automated Testing)
# ------------------------------------------------------------------------------
ANDROID_AVD_NAME=Pixel_7_API_34
ANDROID_RUNNER_TMP=/tmp/runner
ANDROID_EMULATOR_WAIT_MS=30000
ANDROID_ADB_SERIAL=emulator-5554

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Notifications & Password Reset)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="UIGrade AI <noreply@uigrade.edu.vn>"

